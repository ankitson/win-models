set shell := ["powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]

model_root := env_var_or_default("WIN_MODELS_MODEL_ROOT", "E:\\root\\projects\\models")
studio_home := env_var_or_default("UNSLOTH_STUDIO_HOME", "E:\\root\\projects\\unsloth")
studio_port := env_var_or_default("WIN_MODELS_STUDIO_PORT", "8888")
root := module_directory() / "../.."

default:
    @just --justfile "{{ module_directory() }}/Justfile" --working-directory "{{ module_directory() }}" --list

setup zip_dir="":
    @uv --project "{{ root }}" run win-models unsloth setup --studio-home "{{ studio_home }}" --model-root "{{ model_root }}" {{ if zip_dir == "" { "" } else { "--zip-dir " + quote(zip_dir) } }}

serve port=studio_port:
    @uv --project "{{ root }}" run win-models unsloth serve --studio-home "{{ studio_home }}" --model-root "{{ model_root }}" --port {{ port }} --open

serve-lan port=studio_port:
    @uv --project "{{ root }}" run win-models unsloth serve --studio-home "{{ studio_home }}" --model-root "{{ model_root }}" --port {{ port }} --lan

serve-debug port=studio_port:
    @uv --project "{{ root }}" run win-models unsloth serve --studio-home "{{ studio_home }}" --model-root "{{ model_root }}" --port {{ port }} --log-level DEBUG --open --lan

stop port=studio_port:
    @uv --project "{{ root }}" run win-models unsloth stop --studio-home "{{ studio_home }}" --port {{ port }}

register-models path=model_root:
    @uv --project "{{ root }}" run win-models unsloth register "{{ path }}" --studio-home "{{ studio_home }}"
