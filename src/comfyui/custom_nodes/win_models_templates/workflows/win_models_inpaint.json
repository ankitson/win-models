      "title": "Note: Image And Mask",
      "properties": {},
      "widgets_values": [
        "Input Image provides both source pixels and the mask. VAE Encode For Inpaint prepares the masked latent. grow_mask_by expands the painted area before sampling."
      ],
      "color": "#222",
      "bgcolor": "#000"
    },
