      "title": "Note: Save",
      "properties": {},
      "widgets_values": [
        "VAE Decode turns the sampled latent into an image. Save Image writes the result to the ComfyUI output directory."
      ],
      "color": "#222",
      "bgcolor": "#000"
    },
