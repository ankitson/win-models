set shell := ["powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]

model_root := env_var_or_default("WIN_MODELS_MODEL_ROOT", "E:\\root\\projects\\models")
hf_cache := env_var_or_default("UNSLOTH_HF_CACHE", model_root)
hf_token_file := env_var_or_default("WIN_MODELS_HF_TOKEN_FILE", root / "logs" / "hf-token.tmp")
hf_token_op_ref := env_var_or_default("WIN_MODELS_HF_TOKEN_OP_REF", "op://clankers/huggingface-read/password")
