root := module_directory() / "../.."

default: serve-qwen35b-q4kxl

download variant:
    @uv --project "{{ root }}" run win-models plain download "{{ variant }}" --model-root "{{ model_root }}"

download-cache target="new-gemma-26b":
    @Remove-Item Env:SSLKEYLOGFILE -ErrorAction SilentlyContinue; $env:HF_HUB_DISABLE_XET="1"; $env:HF_HUB_ENABLE_HF_TRANSFER="0"; uv --project "{{ root }}" run --python "{{ hf_download_python }}" win-models plain download-cache "{{ target }}" --hf-cache "{{ hf_cache }}" --token-file "{{ hf_token_file }}" --token-op-ref "{{ hf_token_op_ref }}"

